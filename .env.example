# Persona Intelligence — environment variables
# Copy to .env.local and fill in. Placeholder values only; never commit real keys.
# All variables are read on the server at runtime. None are sent to the browser.

# --- Supabase (required for accounts and storage) ---------------------------
# Project URL and anon/publishable key from Supabase → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public base URL of this app (used in auth email links). On Vercel it
# defaults to the production domain automatically.
APP_URL=http://localhost:3000

# --- Database migrations at build time (optional) --------------------------
# When "true", `npm run build` applies supabase/migrations to Persona
# Intelligence's own Supabase database (POSTGRES_URL_NON_POOLING, set by the
# Vercel Supabase integration, or PERSONA_DATABASE_URL). Refuses non-empty or
# non-Supabase databases. Leave unset locally.
# PERSONA_MIGRATE_ON_BUILD=true
# PERSONA_DATABASE_URL=postgresql://...

# --- Live web search (required to run research) -----------------------------
# Provider order: "auto" (Brave, then Tavily), one name, or a list such as
# "tavily,brave". Every configured provider is used for failover; each query
# goes to one provider only. Both support web and news search.
SEARCH_PROVIDER=auto
# Brave Search API: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Tavily: https://tavily.com
TAVILY_API_KEY=
# Optional: route Tavily calls through a gateway/proxy.
# TAVILY_API_BASE_URL=https://api.tavily.com

# --- AI analysis (required for claims, profiles and meeting briefs) ----------
OPENAI_API_KEY=
# Any chat-completions model with JSON-schema structured output.
OPENAI_MODEL=gpt-5-mini
# Optional: OpenAI-compatible endpoint (e.g. Azure/OpenAI proxy).
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Research limits & cost controls (optional; defaults shown) --------------
# RESEARCH_MAX_QUERIES=8
# RESEARCH_RESULTS_PER_QUERY=8
# RESEARCH_MAX_SOURCES=25
# RESEARCH_MAX_PAGE_FETCHES=12
# RESEARCH_MAX_PAGE_BYTES=1500000
# RESEARCH_MAX_CONTENT_CHARS=12000
# RESEARCH_MAX_AI_CALLS=8
# RESEARCH_MAX_RETRIES=2
# RESEARCH_PROVIDER_TIMEOUT_MS=15000
# RESEARCH_JOB_TIMEOUT_MS=240000
# RESEARCH_MAX_CONCURRENT_JOBS=2
# RESEARCH_DAILY_QUOTA=10
# BRIEF_DAILY_QUOTA=30
# Set to "true" to use search snippets only (no page retrieval).
# RESEARCH_DISABLE_PAGE_FETCH=false

# --- Service role (server only; required for payments and guest previews) ---
# Supabase → Project Settings → API → service_role / secret key. Used ONLY by
# the Paddle webhook, entitlement functions and guest→account transfer.
# Never expose it to the browser; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments: Paddle Billing (merchant of record) ----------------------------
# Payments stay disabled (purchase buttons show "not enabled") until all of
# PADDLE_API_KEY, PADDLE_CLIENT_TOKEN, PADDLE_WEBHOOK_SECRET and the service
# role key are set. Start with PADDLE_ENVIRONMENT=sandbox.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# One Paddle price per product (Paddle → Catalog → Products → Prices).
PADDLE_PRICE_SINGLE_REPORT=
PADDLE_PRICE_CREDITS_SMALL=
PADDLE_PRICE_CREDITS_LARGE=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_ANNUAL=
# Display catalogue (must match the Paddle prices). Defaults are a PROPOSAL:
# USD 9 single report; 5 credits 35; 15 credits 90; monthly 29 (30 reports);
# annual 290 (360 reports). Override amounts (minor units), credits and limits:
# BILLING_CURRENCY=USD
# BILLING_CATALOG_JSON={"currency":"ILS","products":{"single_report":{"amountMinor":3900}}}
# Test-only: point the Paddle API at a mock (ignored when PADDLE_ENVIRONMENT=production).
# PADDLE_API_BASE_URL=

# --- Freemium & abuse protection (optional; defaults shown) -------------------
# auto = enforce the paywall only when payments are configured; enforce; off.
# PAYWALL_MODE=auto
# FREE_PREVIEWS_GUEST=1            # locked previews per guest session
# FREE_PREVIEWS_PER_30_DAYS=3      # locked previews per account per 30 days
# FREE_RESEARCH_GLOBAL_DAILY=200   # site-wide cap on free research runs per day
# CREDITS_PER_REPORT=1
# SUBSCRIBER_DAILY_RESEARCH=20
# Cloudflare Turnstile for anonymous previews (recommended in production).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Operators (optional) ------------------------------------------------------
# Comma-separated emails allowed to run the live provider check in Settings
# (one neutral search per provider/category; uses a little provider quota).
# OPERATOR_EMAILS=you@example.com
