# Persona Intelligence — environment variables
# Copy to .env.local and fill in. Placeholder values only; never commit real keys.
# All variables are read on the server at runtime. None are sent to the browser.

# --- Supabase (required for accounts and storage) ---------------------------
# Project URL and anon/publishable key from Supabase → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public base URL of this app (used in auth email links).
APP_URL=http://localhost:3000

# --- Live web search (required to run research) -----------------------------
# "brave", "tavily" or "auto" (first configured key wins).
SEARCH_PROVIDER=auto
# Brave Search API: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Tavily: https://tavily.com
TAVILY_API_KEY=
# Optional: route Tavily calls through a gateway/proxy.
# TAVILY_API_BASE_URL=https://api.tavily.com

# --- AI analysis (required for claims, profiles and meeting briefs) ----------
OPENAI_API_KEY=
# Any chat-completions model with JSON-schema structured output.
OPENAI_MODEL=gpt-5-mini
# Optional: OpenAI-compatible endpoint (e.g. Azure/OpenAI proxy).
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Research limits & cost controls (optional; defaults shown) --------------
# RESEARCH_MAX_QUERIES=8
# RESEARCH_RESULTS_PER_QUERY=8
# RESEARCH_MAX_SOURCES=25
# RESEARCH_MAX_PAGE_FETCHES=12
# RESEARCH_MAX_PAGE_BYTES=1500000
# RESEARCH_MAX_CONTENT_CHARS=12000
# RESEARCH_MAX_AI_CALLS=8
# RESEARCH_MAX_RETRIES=2
# RESEARCH_PROVIDER_TIMEOUT_MS=15000
# RESEARCH_JOB_TIMEOUT_MS=240000
# RESEARCH_MAX_CONCURRENT_JOBS=2
# RESEARCH_DAILY_QUOTA=10
# BRIEF_DAILY_QUOTA=30
# Set to "true" to use search snippets only (no page retrieval).
# RESEARCH_DISABLE_PAGE_FETCH=false
